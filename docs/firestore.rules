rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public-ish profile doc used for the online peer directory. Never
    // stores wallet/financial data — that lives in its own collection below.
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isSignedIn(); // needed for the "who's online" peer directory query
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    // Wallet balance — private. Owner and the CRM admin can read/write it;
    // it is NEVER exposed through the users-collection list query above.
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Wallet ledger (recharges + call charges) used for the CRM finance report.
    match /walletTransactions/{txId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // KYC documents — owner submits (status always starts 'pending'); only
    // the CRM admin can approve/reject. The owner may ALSO flip their own
    // pending submission to 'verified' themselves, but ONLY once the
    // server clock (request.time) shows 12 real hours have passed since
    // the server-stamped submittedAt — this is the client-side 12h
    // auto-approval SLA, and it can't be gamed by the device's local clock
    // since Firestore evaluates request.time server-side.
    match /kyc/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin()
        || (isOwner(uid) && request.resource.data.status == 'pending')
        || (isOwner(uid)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'verified'
            && resource.data.submittedAt is timestamp
            && request.time > resource.data.submittedAt + duration.value(12, 'h'));
      allow delete: if false;
    }

    // Recharge tickets — owner raises a ticket; only the CRM admin can list
    // all tickets, mark them paid, or reject them.
    match /rechargeTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Withdrawal requests (earnings payout to bank/UPI) — owner raises a
    // ticket with their payout details; the CRM admin can list all requests,
    // mark them paid, or reject them. The owner may ALSO list (listen to)
    // just their own tickets, so the app can pop up a notification the
    // moment the CRM marks their request paid/rejected.
    match /withdrawalTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Admin allowlist. A signed-in user may only check THEIR OWN admin doc
    // (so the CRM can confirm "am I an admin?" after login) — nobody can
    // list all admins or write to this collection from a client.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // Editable finance settings (GST rate, payouts, operating costs) used
    // by the CRM's profit estimator.
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
